# Vicmic E-Commerce Platform - Root .htaccess
# This file should be placed in the application root (above public/)
# On cPanel, public_html should point to the public/ directory

# Deny access to everything in root (security)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
