# ===========================================
# Vicmic E-Commerce Platform Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Application
APP_NAME="Vicmic Indonesia"
APP_URL="https://vicmic.id"
APP_ENV="development"
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"

# Database (MySQL/MariaDB)
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="vicmic_db"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"

# Admin Auth
JWT_SECRET="CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING"
SESSION_LIFETIME=7200
BCRYPT_COST=12

# Midtrans Payment Gateway
# Get credentials from: https://dashboard.midtrans.com
MIDTRANS_ENV="sandbox"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
MIDTRANS_API_URL="https://api.sandbox.midtrans.com/v2"

# RajaOngkir Shipping API
# Get API key from: https://rajaongkir.com
RAJAONGKIR_API_KEY=""
RAJAONGKIR_ACCOUNT_TYPE="starter"
RAJAONGKIR_API_URL="https://api.rajaongkir.com/starter"

# File Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES="jpg,jpeg,png,webp,gif"
UPLOAD_PATH="../uploads"

# Webhook Security
WEBHOOK_MIDTRANS_VERIFY=true

# Cache
CACHE_SHIPPING_TTL=3600
CACHE_PRODUCT_TTL=600
